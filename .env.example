# ==============================================================================
# AegisPay AI - Environment Variables
# ==============================================================================

# Server-Side Configuration (Node / Express)
# Set in Google AI Studio Build via Settings > Secrets / Environment Variables
# or locally in a .env file:
PORT=3000
NODE_ENV=development

# Gemini AI API Configuration
# Required for real-time live voice, audio transcription, and AI forensic
# investigations. If not provided, resilient deterministic simulation fallbacks
# are automatically active.
# The server self-tests GEMINI_MODEL_ID on boot and reports the result in
# GET /health/ready (modelCheck) and the console. If the check fails, swap to a
# model your key can access — verified public ids:
#   GEMINI_MODEL_ID=gemini-2.5-flash
#   GEMINI_LIVE_MODEL=gemini-live-2.5-flash-preview   (native-audio realtime)
#   GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# Prebuilt Live voice (natural). Options include Aoede, Kore, Leda, Zephyr, Puck.
GEMINI_LIVE_VOICE=Aoede
GEMINI_LIVE_ENABLED=true

# Cloud SQL / PostgreSQL Database Configuration (Drizzle ORM)
# Automatically provisioned in AI Studio Cloud Run.
# For local development or external hosting:
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
POSTGRES_PORT=5432

# Client-Side Configuration (Vite)
# NOTE: All variables accessible in the browser must be prefixed with VITE_
# Leave empty for same-origin local / full-stack deployment
VITE_API_BASE_URL=