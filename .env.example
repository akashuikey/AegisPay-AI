# -----------------------------------------------------------------------------
# AegisPay AI - Environment Configuration Example
# Copy this file to .env for local development. Never commit real secrets.
# -----------------------------------------------------------------------------

# Application
APP_NAME=AegisPay AI
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# PostgreSQL Database Configuration
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aegispay
POSTGRES_USER=aegispay_user
POSTGRES_PASSWORD=aegispay_dev_pw
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Optional Direct Database URL override (constructed automatically if omitted)
# DATABASE_URL=postgresql+psycopg://aegispay_user:aegispay_dev_pw@127.0.0.1:5432/aegispay

# Cross-Origin Resource Sharing (CORS) - JSON array or comma-separated strings
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Gemini & Google Cloud Vertex AI Configuration
# AI_PROVIDER options: auto, vertex_ai, gemini_api, mock
AI_PROVIDER=auto
GEMINI_MODEL_ID=gemini-2.5-flash
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
# GEMINI_API_KEY=your-gemini-api-key-if-using-developer-api
GEMINI_REQUEST_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RETRIES=2
INVESTIGATION_MAX_CONVERSATION_TURNS=20

# -----------------------------------------------------------------------------
# Authentication (operator identity boundary)
# -----------------------------------------------------------------------------
# REQUIRED for login/auth to work. Must be a long, random, secret string
# (>= 32 bytes recommended). The value below is a DEV placeholder — generate a
# fresh secret for any non-local use, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=dev-only-change-me-use-a-long-random-secret-string
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Bootstrap operator provisioned on startup so the demo has a login.
# The password is read only from env and stored solely as a bcrypt hash.
AUTH_BOOTSTRAP_OPERATOR_USERNAME=operator
AUTH_BOOTSTRAP_OPERATOR_PASSWORD=change-me-in-local-env

# Frontend Public Environment (Used during Vite build/development)
# Note: Vite-exposed variables (VITE_*) are public and bundled into client code. Never put secrets here.
VITE_API_BASE_URL=http://127.0.0.1:8000
