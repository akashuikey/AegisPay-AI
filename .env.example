# -----------------------------------------------------------------------------
# AegisPay AI - Environment Configuration Example
# Copy this file to .env for local development. Never commit real secrets.
# -----------------------------------------------------------------------------

# Application
APP_NAME=AegisPay AI
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# PostgreSQL Database Configuration
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=aegispay
POSTGRES_USER=aegispay_user
POSTGRES_PASSWORD=aegispay_dev_pw
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Optional Direct Database URL override (constructed automatically if omitted)
# DATABASE_URL=postgresql+psycopg://aegispay_user:aegispay_dev_pw@127.0.0.1:5432/aegispay

# Cross-Origin Resource Sharing (CORS) - JSON array or comma-separated strings
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Gemini & Google Cloud Vertex AI Configuration
# AI_PROVIDER options: auto, vertex_ai, gemini_api, mock
AI_PROVIDER=auto
# Text-generation model (forensic investigation, dialogue, coercion analysis).
# Verify availability against your account: entries from client.models.list()
# whose supported_actions include "generateContent".
GEMINI_MODEL_ID=gemini-3.8-flash
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
# GEMINI_API_KEY=your-gemini-api-key-if-using-developer-api
GEMINI_REQUEST_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RETRIES=2
INVESTIGATION_MAX_CONVERSATION_TURNS=20

# Real-time bidirectional Gemini Live voice (P2-A11/A13).
# Requires GEMINI_API_KEY (or GCP_PROJECT_ID). The key never leaves the server.
GEMINI_LIVE_ENABLED=false
# Audio-capable Live model. Model availability changes over time — verify with
# client.models.list() (supported_actions must include "bidiGenerateContent").
# The legacy "gemini-2.0-flash-live-001" was retired; current options include
# gemini-3.8-live and gemini-3.1-flash-live-preview.
GEMINI_LIVE_MODEL=gemini-3.8-live

# -----------------------------------------------------------------------------
# Authentication (operator identity boundary)
# -----------------------------------------------------------------------------
# REQUIRED for login/auth to work. Must be a long, random, secret string
# (>= 32 bytes recommended). The value below is a DEV placeholder — generate a
# fresh secret for any non-local use, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=dev-only-change-me-use-a-long-random-secret-string
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Bounded per-client (IP) login throttle. Keyed by source IP (never by username),
# so it cannot be abused to lock out a specific account. Set max to 0 to disable.
# This is an in-process speed bump, not a replacement for an edge rate limiter.
AUTH_LOGIN_MAX_ATTEMPTS_PER_WINDOW=10
AUTH_LOGIN_WINDOW_SECONDS=60
# Bootstrap operator provisioned on startup so the demo has a login.
# The password is read only from env and stored solely as a bcrypt hash.
AUTH_BOOTSTRAP_OPERATOR_USERNAME=operator
AUTH_BOOTSTRAP_OPERATOR_PASSWORD=change-me-in-local-env

# -----------------------------------------------------------------------------
# Simulated Customer Verification (P2-A5 / P2-A5.1)
# -----------------------------------------------------------------------------
# Optional dedicated HMAC secret for OTP digests (SEC-05 key separation).
# If omitted or empty, safely falls back to AUTH_JWT_SECRET.
# VERIFICATION_HMAC_SECRET=your-dedicated-verification-hmac-secret
# Dev OTP display flag. Reveals the simulated OTP in API responses so the local
# demo verification flow can be completed. It is automatically forced OFF unless
# APP_ENV is a development/test environment (development, dev, local, test,
# testing, ci), so it can never be exposed in a production-like deployment.
# Set APP_ENV=development and this to true for local Scenario Lab verification demos.
VERIFICATION_EXPOSE_DEV_OTP=false

# Frontend Public Environment (Used during Vite build/development)
# Note: Vite-exposed variables (VITE_*) are public and bundled into client code. Never put secrets here.
VITE_API_BASE_URL=http://127.0.0.1:8000
